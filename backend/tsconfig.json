{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    // NodeNext: a Vercel compila cada arquivo sem empacotar (não usa bundler),
    // então os imports relativos precisam da extensão .js para funcionar no
    // Node em modo ES module, exatamente como o TypeScript exige aqui
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    // O build local só checa tipos; quem gera o JavaScript é a Vercel
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
