# Copie para backend/.env e preencha. O .env nunca vai para o git.
# Para o Supabase, o jeito mais simples é `vercel env pull .env` dentro de
# backend/ (o projeto já está ligado à Vercel).

# Porta do servidor local (padrão 3333, a mesma do proxy do Vite)
PORTA=3333

# Supabase (criadas pela integração do Marketplace da Vercel)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Origens do site autorizadas a chamar a API, separadas por vírgula e sem barra
# final. Em produção é obrigatória (sem ela a API recusa os POST). Em
# desenvolvimento pode ficar vazia: localhost é aceito.
ORIGEM_FRONTEND=

# Segredo do Cron da Vercel (despertador diário do banco). Opcional: sem ele a
# API sobe normal e só a rota /api/cron/manter-ativo responde 401. Se definido,
# use 16 caracteres ou mais. O valor é criado no painel da Vercel e nunca vai
# para o git.
CRON_SECRET=

# Melhor Envio (frete). Para desenvolvimento use SEMPRE o token e o ambiente de
# SANDBOX (sandbox.melhorenvio.com.br); o token de produção fica só na Vercel e
# `producao` só é aceito rodando em produção. Sem o token a cotação devolve só a
# retirada na clínica. Sem aspas e sem espaços ao redor do =.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_AMBIENTE=sandbox

# Rede (e.Rede, pagamento). Ainda NÃO lidas pelo backend: o código de pagamento
# espera a resposta da Rede sobre o fim do e.Rede em 2027. Só sandbox no .env
# local; as de produção ficam só na Vercel.
REDE_PV=
REDE_CHAVE_INTEGRACAO=
REDE_AMBIENTE=sandbox
