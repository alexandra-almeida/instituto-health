# Copie para backend/.env e preencha. O .env nunca vai para o git.
# Para o Supabase, o jeito mais simples é `vercel env pull .env` dentro de
# backend/ (o projeto já está ligado à Vercel).

# Porta do servidor local (padrão 3333, a mesma do proxy do Vite)
PORTA=3333

# Supabase (criadas pela integração do Marketplace da Vercel)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Origens do site autorizadas a chamar a API, separadas por vírgula e sem barra
# final. Em produção é obrigatória (sem ela a API recusa os POST). Em
# desenvolvimento pode ficar vazia: localhost é aceito.
ORIGEM_FRONTEND=
